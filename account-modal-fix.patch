diff --git a/src/App.css b/src/App.css
index 86796ed..b5210b7 100644
--- a/src/App.css
+++ b/src/App.css
@@ -1330,6 +1330,68 @@ section {
   flex-direction: column;
   gap: 18px;
   overflow: hidden;
+  animation: accountModalPop 0.25s ease;
+}
+
+.account-modal-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(43, 30, 20, 0.55);
+  backdrop-filter: blur(3px);
+  -webkit-backdrop-filter: blur(3px);
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 20px;
+  animation: accountModalFadeIn 0.2s ease;
+}
+
+.account-modal-close {
+  position: absolute;
+  top: 16px;
+  right: 16px;
+  width: 34px;
+  height: 34px;
+  border-radius: 50%;
+  background: rgba(139, 115, 85, 0.08);
+  border: none;
+  color: #8b7355;
+  font-size: 22px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+.account-modal-close:hover {
+  background-color: #a07a59;
+  color: #ffffff;
+}
+
+.account-modal-title {
+  margin: 0;
+  font-size: 20px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  color: #4f3c2a;
+}
+
+@keyframes accountModalFadeIn {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+@keyframes accountModalPop {
+  from {
+    opacity: 0;
+    transform: translateY(14px) scale(0.97);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
 }
 
